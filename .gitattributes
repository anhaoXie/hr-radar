# 统一换行符，避免 Windows/macOS/Linux 之间产生无意义的整文件 diff
* text=auto

*.py     text eol=lf
*.js     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.txt    text eol=lf

# Windows 批处理必须是 CRLF，否则老版本 cmd 解析会出问题
*.bat    text eol=crlf

# 二进制资源不做换行转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.db     binary
